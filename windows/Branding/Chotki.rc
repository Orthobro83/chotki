#include <windows.h>
#include "Version.h"

1 ICON "Chotki.ico"
1 RT_MANIFEST "Chotki.manifest"

1 VERSIONINFO
 FILEVERSION CHOTKI_FILE_VERSION
 PRODUCTVERSION CHOTKI_FILE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Chotki\0"
   VALUE "FileDescription", "Chotki\0"
   VALUE "FileVersion", CHOTKI_FILE_VERSION_TEXT
   VALUE "InternalName", "ChotkiWindows\0"
   VALUE "OriginalFilename", "ChotkiWindows.exe\0"
   VALUE "ProductName", "Chotki\0"
   VALUE "ProductVersion", CHOTKI_PRODUCT_VERSION_TEXT
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
