<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The church calendar comes from orthocal.info, and that is the only
         request this app makes. Without this every fetch throws a
         SecurityException, which the refresh swallows — so the app says "no
         reading stored for this day yet" for ever, and nothing says why. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- A runtime permission from Android 13. Without it nothing appears and
         nothing errors, which is the most likely way for reminders to fail
         silently on the device this is aimed at. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A rule kept at 06:30 reminded "sometime this morning" is not a
         reminder. Without an exact alarm the system quietly downgrades rather
         than refusing, so the failure is a reminder that drifts.

         Play allows USE_EXACT_ALARM only for an alarm clock or a calendar.
         This is neither, so the person grants SCHEDULE_EXACT_ALARM instead.
         Below Android 12 that permission does not exist and exact alarms
         need no grant. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Alarms do not survive a restart. Without this a phone rebooted
         overnight comes back with nothing scheduled. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Chotki"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Chotki"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".platform.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".platform.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
